# Environment Variables for Vertical Forge

# Next.js Public Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Vertical Forge"
NEXT_PUBLIC_SITE_TAGLINE="Building Specialized Digital Solutions for Businesses"

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/vertical_forge

# Email Notifications (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=leads@verticalforge.io
SMTP_PASS=your-app-password-here
NOTIFICATION_EMAIL=info@verticalforge.io

# Standalone Express Server Configuration
PORT=5000
NODE_ENV=development
